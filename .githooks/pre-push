#!/bin/sh
# Pre-push gate — agentic-sdlc.
#
# Wired by `git config core.hooksPath .githooks`, which bootstrap.sh runs. That
# is native git: no hook manager, no package.json, no dependency a project has
# not chosen yet.
#
# Two checks, each with its own logged escape hatch:
#   1. docs gate    — scripts/check.sh          bypass: PUSH_WITHOUT_DOCS=1
#   2. TDD pairing  — pushed source changes must come with test changes
#                     bypass: PUSH_WITHOUT_TESTS=1
#
# Both follow the same shape: a script that OWNS the rule, and a hook that only
# resolves the range and calls it. The rules are therefore runnable, testable,
# and re-runnable in CI from the same source — see templates/workflows/.
#
# The bypasses are deliberate and LOUD. A guard with no escape hatch gets
# disabled wholesale the first time it is wrong; one with a logged hatch stays
# on. Each bypass is also NARROW — PUSH_WITHOUT_DOCS does not disable the
# pairing guard, and vice versa — because a single "skip everything" switch is
# the one people reach for reflexively.
#
# A bypass only DEFERS the failure. CI re-runs both gates, and getting past the
# CI half of the pairing rule needs the `tdd-exempt` pull-request label, where
# the override is visible to whoever reviews it rather than living in one
# person's shell history.

root=$(git rev-parse --show-toplevel) || exit 1

# --- 1. docs gate -----------------------------------------------------------
if [ "${PUSH_WITHOUT_DOCS:-}" = "1" ]; then
	echo "WARNING  PUSH_WITHOUT_DOCS=1 — docs gate BYPASSED for this push." >&2
else
	sh "$root/scripts/check.sh" || {
		echo "" >&2
		echo "x pre-push: docs gate failed (see above)." >&2
		echo "  Fix it, or bypass once with: PUSH_WITHOUT_DOCS=1 git push" >&2
		exit 1
	}
fi

# --- 2. TDD pairing guard ---------------------------------------------------
# The RULE is scripts/tdd-pairing-guard.sh; WHAT COUNTS as source and test is
# scripts/guards.config.sh. This hook contributes only the ref range, which is
# the one thing a pre-push hook knows and a CI job does not.
if [ "${PUSH_WITHOUT_TESTS:-}" = "1" ]; then
	echo "WARNING  PUSH_WITHOUT_TESTS=1 — TDD pairing guard BYPASSED for this push." >&2
	exit 0
fi

guard="$root/scripts/tdd-pairing-guard.sh"
[ -f "$guard" ] || exit 0

hint="Write the failing test first, or bypass once with: PUSH_WITHOUT_TESTS=1 git push"

zero=0000000000000000000000000000000000000000
fail=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
	[ -z "$local_sha" ] && continue
	[ "$local_sha" = "$zero" ] && continue # deleting a remote ref — nothing outgoing
	if [ "$remote_sha" = "$zero" ]; then
		# New remote branch: diff against where it forked from the default branch.
		base=$(git merge-base "$local_sha" origin/HEAD 2>/dev/null) ||
			base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=""
	else
		base=$remote_sha
	fi
	[ -z "$base" ] && continue # cannot resolve a base — do not block on a guess

	sh "$guard" "$base" "$local_sha" --label pre-push --hint "$hint"
	status=$?
	# One push, one "guard is unconfigured" warning, however many refs it carries.
	TDD_PAIRING_GUARD_QUIET=1
	export TDD_PAIRING_GUARD_QUIET
	# Only an actual pairing violation (1) blocks. Exit 2 means the range could
	# not be diffed at all — same stance as the unresolvable base above: do not
	# block on a guess.
	[ "$status" = "1" ] && fail=1
done

exit $fail
