// Mutation testing configuration — the node-ts adapter's worked example.
//
//   cp adapters/node-ts/mutation/stryker.config.mjs.example \
//      packages/<your-pure-package>/stryker.config.mjs
//
// It lives INSIDE the package it mutates, not at the repo root, because the
// scope is one package (see mutation.config.sh.example §1) and the run is
// executed from there.
//
// AN ON-DEMAND / DIFFERENTIAL DIAGNOSTIC, NOT A PER-PUSH CHECK. Run it when you
// want to know whether a package's tests are load-bearing, or — the usual case —
// let mutation-delta.sh run it against just the files a branch changed. Pick a
// PURE package as the calibration target: no I/O, no environment, so every
// mutant costs a function call rather than a container.
//
// WHY .mjs AND NOT .json. The JSON form has nowhere to put reasoning: comment
// keys like `_comment` are reported by Stryker's own validator as unknown
// options, and a `$schema` pointing into `node_modules` does not resolve under
// pnpm's isolated layout (the package's copy is a symlink into `.pnpm/`, and
// the workspace root has no `@stryker-mutator` directory at all). A JS config
// takes real comments and needs no schema pointer, so the notes below cost
// nothing and the warnings go away.

/** @type {import('@stryker-mutator/api/core').PartialStrykerOptions} */
export default {
  packageManager: "pnpm",
  testRunner: "vitest",

  // Explicit, not the default `@stryker-mutator/*` glob: under pnpm's isolated
  // node_modules that glob finds no sibling plugins next to the hoisted core,
  // and the runner dies with 'Cannot find TestRunner plugin "vitest"'.
  plugins: ["@stryker-mutator/vitest-runner"],

  vitest: { configFile: "vitest.config.ts" },

  // Per-test coverage: Stryker then runs only the tests that actually cover a
  // mutant instead of the whole file's suite. On a pure package this is the
  // difference between a diagnostic you run and one you talk about running.
  coverageAnalysis: "perTest",

  // KEEP IN STEP WITH MUTATION_SRC_RE / MUTATION_SRC_EXCLUDE_RE in
  // mutation.config.sh. If the two disagree, the differential run measures a
  // different surface from the full run and the two scores stop being
  // comparable — which is the whole point of having both.
  //
  // `!src/index.ts`: a barrel is re-exports, and a mutant in a re-export is
  // noise. The TDD pairing guard excludes barrels for the same reason.
  mutate: ["src/**/*.ts", "!src/**/*.test.ts", "!src/index.ts"],

  // Tune to the runner, not to the machine. Too high and the suites contend for
  // CPU and start timing out, which shows up as false "killed by timeout".
  concurrency: 4,

  reporters: ["html", "clear-text", "progress"],
  htmlReporter: { fileName: "reports/mutation/mutation.html" },

  // DO NOT set `jsonReporter.fileName`. mutation-delta.sh reads the path named
  // by MUTATION_REPORT in mutation.config.sh, which is the json reporter's
  // default; moving it makes the script find nothing and take its
  // "produced no report" branch — a green-looking skip rather than an error.

  // DIAGNOSTIC, NOT A GATE: `break: null` means a low score never fails the
  // run. `high` and `low` only colour the report. A surviving mutant is a
  // question for a human, not a build failure — and a threshold is a number
  // people learn to defend rather than a signal they read.
  thresholds: { high: 90, low: 80, break: null },

  tempDirName: ".stryker-tmp",
  cleanTempDir: true,
};
